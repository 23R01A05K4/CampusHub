# Copy to backend/.env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=5000

# Database: either a full connection string...
MONGO_URI=mongodb://127.0.0.1:27017/campushub
# ...or Atlas parts (used when MONGO_URI is not set)
# MONGO_HOST=your-cluster.xxxxx.mongodb.net
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_DB=campushub

# Required in production: 32+ random characters
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins (production)
# CORS_ORIGINS=https://your-app.example.com
# Where uploaded images are stored (default is inside the project)
# UPLOAD_DIR=/tmp/uploads

# node seed.js (demo accounts, 12+ characters each)
# DEMO_ADMIN_PASSWORD=
# DEMO_STUDENT_PASSWORD=

# node create_sa.js
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# Optional: email (welcome mail, OTP, reminders). Leave empty to disable.
# EMAIL_USER=
# EMAIL_PASS=

# Optional: Google sign-in. Leave empty to disable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:3000
# API_URL=http://localhost:5000

# Frontend build only: API base URL (set when building the frontend)
# REACT_APP_API=http://localhost:5000
